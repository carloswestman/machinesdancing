#!/usr/bin/env python3
"""github-token: mints a GitHub App installation token for one repo.

  sudo github-token APP OWNER/REPO

Prints the token, and nothing else, on stdout. It lasts an hour (GitHub's
fixed limit) and is narrowed to OWNER/REPO, with contents and pull requests,
read and write: what an agent needs to work there (docs/design/repo-access.md).

APP names a credential: a directory under /etc/machinesdancing/credentials
(MD_CREDENTIALS overrides it) holding the App's private-key.pem and app.json,
as scripts/create-github-app saved them and scripts/install-github-app put
them there. Root only: the key is the App's long-lived secret, and never
leaves this host.
"""

import base64
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

API = "https://api.github.com"
PERMISSIONS = {"contents": "write", "pull_requests": "write"}


def b64(b):
    return base64.urlsafe_b64encode(b).rstrip(b"=")


def jwt(app_id, key):
    """The App's own short-lived credential, signed with its private key (RS256)."""
    now = int(time.time())
    head = b64(json.dumps({"alg": "RS256", "typ": "JWT"}).encode())
    # Back-dated a minute for clock skew; GitHub allows at most ten minutes.
    body = b64(json.dumps({"iat": now - 60, "exp": now + 540, "iss": str(app_id)}).encode())
    signed = head + b"." + body
    sig = subprocess.run(["openssl", "dgst", "-sha256", "-sign", key],
                         input=signed, capture_output=True, check=True).stdout
    return (signed + b"." + b64(sig)).decode()


def call(method, path, token, payload=None, not_found=None):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(API + path, data=data, method=method, headers={
        "Authorization": "Bearer " + token,
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
    })
    try:
        with urllib.request.urlopen(req) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as e:
        if e.code == 404 and not_found:
            sys.exit(f"github-token: {not_found}")
        sys.exit(f"github-token: {method} {path}: {e.code} {e.read().decode(errors='replace')}")


def main():
    if len(sys.argv) != 3 or sys.argv[2].count("/") != 1:
        sys.exit("usage: github-token APP OWNER/REPO")
    app, repo = sys.argv[1], sys.argv[2]
    if "/" in app or app.startswith("."):
        sys.exit(f"github-token: bad credential name: {app}")

    creds = os.environ.get("MD_CREDENTIALS", "/etc/machinesdancing/credentials")
    d = os.path.join(creds, app)
    try:
        with open(os.path.join(d, "app.json")) as f:
            app_id = json.load(f)["id"]
    except OSError as e:
        sys.exit(f"github-token: no App {app}: {e}")

    owner, name = repo.split("/")
    j = jwt(app_id, os.path.join(d, "private-key.pem"))
    inst = call("GET", f"/repos/{urllib.parse.quote(owner)}/{urllib.parse.quote(name)}/installation", j,
                not_found=f"{app} isn't installed on {repo}")
    tok = call("POST", f"/app/installations/{inst['id']}/access_tokens", j,
               {"repositories": [name], "permissions": PERMISSIONS})
    print(tok["token"])


if __name__ == "__main__":
    main()
