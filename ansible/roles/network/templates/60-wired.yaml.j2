# Managed by Ansible (network role). Wired ports use DHCP and are preferred
# over Wi-Fi, which the installer's config keeps as a fallback.
network:
  version: 2
  ethernets:
{% for iface in network_wired_interfaces %}
    {{ iface }}:
      dhcp4: true
      dhcp4-overrides:
        route-metric: 100
{% endfor %}
