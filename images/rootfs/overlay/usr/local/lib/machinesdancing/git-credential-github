#!/bin/sh
# git credential helper for github.com: answers "get" with a placeholder.
# barre sets the real credential on every request to github.com
# (docs/design/barre.md, G2), so the VM holds none. "store" and "erase" do
# nothing.
[ "$1" = get ] || exit 0
cat >/dev/null
printf 'username=x-access-token\npassword=placeholder\n'
