#!/bin/sh
# git credential helper for github.com: answers "get" with the token the host
# keeps fresh in /run/agent/github-token, read on every call, so a replaced
# token is used at once. "store" and "erase" do nothing: the host owns it.
[ "$1" = get ] || exit 0
cat >/dev/null
token=/run/agent/github-token
[ -r "$token" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$token")"
