#!/bin/sh
# gh, with a placeholder token: barre sets the real one on every request to
# api.github.com (docs/design/barre.md, G2), so the VM holds none. The real gh
# is in /usr/local/lib/gh.
GH_TOKEN=${GH_TOKEN:-placeholder} GH_NO_UPDATE_NOTIFIER=1 GH_PROMPT_DISABLED=1
export GH_TOKEN GH_NO_UPDATE_NOTIFIER GH_PROMPT_DISABLED
exec /usr/local/lib/gh/bin/gh "$@"
