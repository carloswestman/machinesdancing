#!/usr/bin/env bash
# build: builds the guest root filesystem, an ext4 image of minimal Ubuntu.
#
# Runs on the VM host as root (mmdebstrap needs it to set file ownership and
# run package scripts). Expects the jete-agent binary next to this script.
# From the Mac, use scripts/build-rootfs, which builds jete-agent, copies it
# and this directory to the host, and runs this there.
#
# The result is <out>/ubuntu-<version>-<UTC timestamp>.ext4, its package
# manifest next to it (.manifest), and the symlink ubuntu-<version>.ext4
# pointing at the newest build. Images are never modified after they are
# built: VMs boot from reflinked copies.
#
# Environment:
#   ROOTFS_OUT     output directory (default: /var/lib/vms/images/rootfs)
#   ROOTFS_SIZE    image size, sparse (default: 2G)
#   ROOTFS_MIRROR  Ubuntu archive (default: http://archive.ubuntu.com/ubuntu)

set -euo pipefail

version=26.04
suite=resolute
out=${ROOTFS_OUT:-/var/lib/vms/images/rootfs}
size=${ROOTFS_SIZE:-2G}
mirror=${ROOTFS_MIRROR:-http://archive.ubuntu.com/ubuntu}

# systemd as init, udev for /dev, CA certificates for TLS, curl for HTTP
# (agents need it, and the gateway's tests use it). Everything else is added
# when something in the guest needs it.
packages=systemd-sysv,udev,ca-certificates,curl

here=$(cd "$(dirname "$0")" && pwd)

if [[ $EUID -ne 0 ]]; then
  echo "build: must run as root" >&2
  exit 1
fi
if [[ ! -x $here/jete-agent ]]; then
  echo "build: $here/jete-agent is missing; run scripts/build-rootfs from the Mac" >&2
  exit 1
fi

mkdir -p "$out"
# The work directory lives next to the output, on the same filesystem, so
# the final move is atomic and nothing large lands in /tmp.
work=$(mktemp -d "$out/.build.XXXXXX")
trap 'rm -rf "$work"' EXIT
# mktemp makes it 0700. apt downloads as the unprivileged _apt user and
# falls back to root if it can't reach the chroot.
chmod 0755 "$work"

stamp=$(date -u +%Y%m%dT%H%M%SZ)
name=ubuntu-$version-$stamp

mmdebstrap \
  --variant=minbase \
  --components=main \
  --include="$packages" \
  --customize-hook="sync-in '$here/overlay' /" \
  --customize-hook="copy-in '$here/jete-agent' /usr/local/bin" \
  --customize-hook='chroot "$1" systemctl enable jete-agent.service' \
  --customize-hook='chroot "$1" passwd --lock root' \
  --customize-hook='rm -f "$1/etc/machine-id" && touch "$1/etc/machine-id"' \
  --customize-hook="chroot \"\$1\" dpkg-query -W -f='\${Package} \${Version}\n' > '$work/$name.manifest'" \
  "$suite" "$work/rootfs" "$mirror"
echo "jete-agent sha256:$(sha256sum "$here/jete-agent" | cut -d' ' -f1)" >> "$work/$name.manifest"

# The guest kernel configures the network from jete's boot line (ip=...) and
# writes the resolver it was given to /proc/net/pnp, in resolv.conf format.
# Set after mmdebstrap, which manages resolv.conf itself while it builds.
ln -sfn /proc/net/pnp "$work/rootfs/etc/resolv.conf"

# mke2fs copies the tree into the new filesystem, keeping ownership and
# modes, without mounting anything.
mke2fs -q -t ext4 -L rootfs -d "$work/rootfs" "$work/$name.ext4" "$size"
chmod 0444 "$work/$name.ext4" "$work/$name.manifest"

mv "$work/$name.ext4" "$work/$name.manifest" "$out/"
ln -sfn "$name.ext4" "$out/ubuntu-$version.ext4"

echo "$out/$name.ext4"
