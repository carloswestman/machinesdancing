#!/usr/bin/env bash
# build: builds the guest root filesystem, an ext4 image of minimal Ubuntu.
#
# Runs on the VM host as root (mmdebstrap needs it to set file ownership and
# run package scripts). Expects the jete-agent binary next to this script.
# From the Mac, use scripts/build-rootfs, which builds jete-agent, copies it
# and this directory to the host, and runs this there.
#
# The result is <out>/ubuntu-<version>-<UTC timestamp>.ext4, its package
# manifest next to it (.manifest), and the symlink ubuntu-<version>.ext4
# pointing at the newest build. Images are never modified after they are
# built: VMs boot from reflinked copies.
#
# Environment:
#   ROOTFS_OUT     output directory (default: /var/lib/vms/images/rootfs)
#   ROOTFS_SIZE    image size, sparse (default: 2G)
#   ROOTFS_MIRROR  Ubuntu archive (default: http://archive.ubuntu.com/ubuntu)
#   CLAUDE_CODE_VERSION  Claude Code release to include: stable, latest or
#                  a version number (default: stable)
#   GH_VERSION     GitHub CLI release to include: latest or a version number
#                  (default: latest)

set -euo pipefail

version=26.04
suite=resolute
out=${ROOTFS_OUT:-/var/lib/vms/images/rootfs}
size=${ROOTFS_SIZE:-2G}
mirror=${ROOTFS_MIRROR:-http://archive.ubuntu.com/ubuntu}
claude_version=${CLAUDE_CODE_VERSION:-stable}
claude_releases=https://downloads.claude.ai/claude-code-releases
gh_version=${GH_VERSION:-latest}
gh_releases=https://github.com/cli/cli/releases

# systemd as init, udev for /dev, CA certificates for TLS, curl for HTTP
# (agents need it, and the gateway's tests use it), git for the repos agents
# work on. Everything else is added when something in the guest needs it.
packages=systemd-sysv,udev,ca-certificates,curl,git

here=$(cd "$(dirname "$0")" && pwd)

if [[ $EUID -ne 0 ]]; then
  echo "build: must run as root" >&2
  exit 1
fi
if [[ ! -x $here/jete-agent ]]; then
  echo "build: $here/jete-agent is missing; run scripts/build-rootfs from the Mac" >&2
  exit 1
fi

mkdir -p "$out"
# The work directory lives next to the output, on the same filesystem, so
# the final move is atomic and nothing large lands in /tmp.
work=$(mktemp -d "$out/.build.XXXXXX")
trap 'rm -rf "$work"' EXIT
# mktemp makes it 0700. apt downloads as the unprivileged _apt user and
# falls back to root if it can't reach the chroot.
chmod 0755 "$work"

# Claude Code, the first agent the VMs run: its native binary, checked
# against the release manifest's checksum, as its installer does. Installed
# as /usr/local/bin/claude; it doesn't update itself in the guest.
if [[ ! $claude_version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  claude_version=$(curl -fsS "$claude_releases/$claude_version")
fi
claude_sum=$(curl -fsS "$claude_releases/$claude_version/manifest.json" |
  python3 -c 'import json, sys; print(json.load(sys.stdin)["platforms"]["linux-x64"]["checksum"])')
curl -fsS -o "$work/claude" "$claude_releases/$claude_version/linux-x64/claude"
echo "$claude_sum  $work/claude" | sha256sum --check --quiet
chmod 0755 "$work/claude"

# The GitHub CLI, from its release, checked against the release's checksums.
# Installed in /usr/local/lib/gh; /usr/local/bin/gh (in the overlay) wraps it
# to read the token the host writes to /run/agent (docs/design/repo-access.md).
if [[ $gh_version == latest ]]; then
  gh_version=$(curl -fsS -o /dev/null -w '%{redirect_url}' "$gh_releases/latest")
  gh_version=${gh_version##*/v}
fi
gh_tar=gh_${gh_version}_linux_amd64.tar.gz
curl -fsSL -o "$work/$gh_tar" "$gh_releases/download/v$gh_version/$gh_tar"
gh_sum=$(curl -fsSL "$gh_releases/download/v$gh_version/gh_${gh_version}_checksums.txt" |
  awk -v f="$gh_tar" '$2 == f { print $1 }')
[[ -n $gh_sum ]] || { echo "build: no checksum for $gh_tar" >&2; exit 1; }
echo "$gh_sum  $work/$gh_tar" | sha256sum --check --quiet
mkdir "$work/gh"
tar -C "$work/gh" --strip-components=1 -xzf "$work/$gh_tar"

stamp=$(date -u +%Y%m%dT%H%M%SZ)
name=ubuntu-$version-$stamp

mmdebstrap \
  --variant=minbase \
  --components=main \
  --include="$packages" \
  --customize-hook="sync-in '$here/overlay' /" \
  --customize-hook="copy-in '$here/jete-agent' /usr/local/bin" \
  --customize-hook="copy-in '$work/claude' /usr/local/bin" \
  --customize-hook="copy-in '$work/gh' /usr/local/lib" \
  --customize-hook='chroot "$1" systemctl enable jete-agent.service' \
  --customize-hook='chroot "$1" useradd --create-home --shell /bin/bash agent' \
  --customize-hook='chroot "$1" passwd --lock root' \
  --customize-hook='rm -f "$1/etc/machine-id" && touch "$1/etc/machine-id"' \
  --customize-hook="chroot \"\$1\" dpkg-query -W -f='\${Package} \${Version}\n' > '$work/$name.manifest'" \
  "$suite" "$work/rootfs" "$mirror"
echo "jete-agent sha256:$(sha256sum "$here/jete-agent" | cut -d' ' -f1)" >> "$work/$name.manifest"
echo "claude-code $claude_version sha256:$claude_sum" >> "$work/$name.manifest"
echo "gh $gh_version sha256:$gh_sum" >> "$work/$name.manifest"

# The guest kernel configures the network from jete's boot line (ip=...) and
# writes the resolver it was given to /proc/net/pnp, in resolv.conf format.
# Set after mmdebstrap, which manages resolv.conf itself while it builds.
ln -sfn /proc/net/pnp "$work/rootfs/etc/resolv.conf"

# mke2fs copies the tree into the new filesystem, keeping ownership and
# modes, without mounting anything.
mke2fs -q -t ext4 -L rootfs -d "$work/rootfs" "$work/$name.ext4" "$size"
chmod 0444 "$work/$name.ext4" "$work/$name.manifest"

mv "$work/$name.ext4" "$work/$name.manifest" "$out/"
ln -sfn "$name.ext4" "$out/ubuntu-$version.ext4"

echo "$out/$name.ext4"
