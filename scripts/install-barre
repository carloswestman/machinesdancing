#!/usr/bin/env bash
# install-barre: builds barre (release) and installs it on the VM hosts as a
# service, with barre-vm, through ansible/barre.yml. Arguments go to
# ansible-playbook, e.g. --check --diff for a dry run, or --limit <host>.

set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)

cargo build --release --package barre --manifest-path "$repo/Cargo.toml"
cd "$repo/ansible"
ansible-playbook barre.yml "$@"
