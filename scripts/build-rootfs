#!/usr/bin/env bash
# build-rootfs: builds the guest root filesystem on the VM host, from the Mac.
#
# Copies images/rootfs to the host and runs its build script there under
# sudo. Prints the path of the new image on the host. See images/rootfs/build
# for what it produces and the ROOTFS_* settings, which are forwarded.
#
# Environment:
#   JETE_HOST   SSH host to build on (default: hemlock)

set -euo pipefail

host=${JETE_HOST:-hemlock}
repo=$(cd "$(dirname "$0")/.." && pwd)
remote_dir=.cache/jete-build

env_prefix=""
for var in ROOTFS_OUT ROOTFS_SIZE ROOTFS_MIRROR; do
  if [[ -n ${!var:-} ]]; then
    env_prefix+="$var=$(printf '%q' "${!var}") "
  fi
done

COPYFILE_DISABLE=1 tar --no-xattrs --no-mac-metadata -C "$repo/images" -cf - rootfs |
  ssh "$host" "rm -rf $remote_dir && mkdir -p $remote_dir && tar -C $remote_dir -xf -"
ssh "$host" "sudo env ${env_prefix}$remote_dir/rootfs/build; rc=\$?; rm -rf $remote_dir; exit \$rc"
