#!/usr/bin/env bash
# build-rootfs: builds the guest root filesystem on the VM host, from the Mac.
#
# Builds jete-agent (release), copies it and images/rootfs to the host, and
# runs the build script there under sudo. Prints the path of the new image on the host. See images/rootfs/build
# for what it produces and its settings (ROOTFS_*, CLAUDE_CODE_VERSION, GH_VERSION), which are forwarded.
#
# Environment:
#   JETE_HOST   SSH host to build on (default: hemlock)

set -euo pipefail

host=${JETE_HOST:-hemlock}
repo=$(cd "$(dirname "$0")/.." && pwd)
remote_dir=.cache/jete-build

env_prefix=""
for var in ROOTFS_OUT ROOTFS_SIZE ROOTFS_MIRROR CLAUDE_CODE_VERSION GH_VERSION; do
  if [[ -n ${!var:-} ]]; then
    env_prefix+="$var=$(printf '%q' "${!var}") "
  fi
done

cargo build --release --package jete-agent --manifest-path "$repo/Cargo.toml"
agent=$repo/target/x86_64-unknown-linux-musl/release/jete-agent

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
cp -R "$repo/images/rootfs" "$stage/rootfs"
cp "$agent" "$stage/rootfs/jete-agent"

COPYFILE_DISABLE=1 tar --no-xattrs --no-mac-metadata -C "$stage" -cf - rootfs |
  ssh "$host" "rm -rf $remote_dir && mkdir -p $remote_dir && tar -C $remote_dir -xf -"
ssh "$host" "sudo env ${env_prefix}$remote_dir/rootfs/build; rc=\$?; rm -rf $remote_dir; exit \$rc"
