#!/usr/bin/env bash
# hemlock-run: cargo runner that executes a Linux binary on the KVM host.
#
# Cargo calls this with the path of a freshly built binary (a test, or a
# `cargo run` target) followed by its arguments, because .cargo/config.toml
# sets it as the runner for x86_64-unknown-linux-musl. The binary is copied
# to the host over SSH and run there with the same arguments. Output streams
# back and the exit code is passed through, so `cargo test` on the Mac
# reports results from the host.
#
# Copies are named by content hash and kept for a day, so an unchanged
# binary is not sent again, and concurrent runs never overwrite one another.
# Uploads are compressed: debug binaries shrink about four times.
#
# Environment:
#   JETE_HOST       SSH host to run on (default: hemlock)
#   JETE_RUN_SUDO   set to 1 to run the binary under sudo on the host
#   RUST_BACKTRACE, RUST_LOG, RUST_TEST_THREADS are forwarded if set.

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: hemlock-run <binary> [args...]" >&2
  exit 2
fi

host=${JETE_HOST:-hemlock}
binary=$1
shift
hash=$(shasum -a 256 "$binary" | cut -c1-16)
name=$(basename "$binary")-$hash
remote_dir=.cache/jete-run

# Reuse one SSH connection across the many calls of a test run.
ssh_opts=(-o ControlMaster=auto -o "ControlPath=$HOME/.ssh/cm-%r@%h:%p" -o ControlPersist=60)

# Upload unless the host already has this exact build. It lands under a
# temporary name and is renamed into place, so a reader never sees half a
# file. Setup reads nothing from our stdin: that belongs to the binary.
if ! ssh -n "${ssh_opts[@]}" "$host" "mkdir -p $remote_dir && test -x $remote_dir/$name"; then
  gzip -1 -c "$binary" | ssh "${ssh_opts[@]}" "$host" \
    "cd $remote_dir && gunzip > $name.part.\$\$ && chmod +x $name.part.\$\$ && mv $name.part.\$\$ $name"
fi

env_prefix=""
for var in RUST_BACKTRACE RUST_LOG RUST_TEST_THREADS; do
  if [[ -n ${!var:-} ]]; then
    env_prefix+="$var=$(printf '%q' "${!var}") "
  fi
done

sudo_prefix=""
if [[ ${JETE_RUN_SUDO:-0} == 1 ]]; then
  sudo_prefix="sudo "
fi

args=""
if [[ $# -gt 0 ]]; then
  args=$(printf '%q ' "$@")
fi

# A terminal on our side gets one on the host too, for interactive commands.
# (A plain string, not an array: macOS bash 3.2 treats an empty array as
# unset under `set -u`.)
tty_opt=-T
if [[ -t 0 && -t 1 ]]; then
  tty_opt=-t
fi

set +e
ssh "${ssh_opts[@]}" "$tty_opt" "$host" \
  "cd $remote_dir && touch $name && ${sudo_prefix}env ${env_prefix}./$name $args; rc=\$?; find . -maxdepth 1 -type f -mmin +1440 -delete; exit \$rc"
rc=$?
set -e
exit $rc
